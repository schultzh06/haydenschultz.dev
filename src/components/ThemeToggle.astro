---
import { Icon } from 'astro-icon/components';
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  class="text-fg/50 transition-colors hover:text-accent cursor-pointer"
>
  <Icon name="lucide:sun" class="hidden h-[18px] w-[18px] dark:block" />
  <Icon name="lucide:moon" class="block h-[18px] w-[18px] dark:hidden" />
</button>

<script>
  const root = document.documentElement;

  function applyStoredTheme() {
    const stored = localStorage.getItem('theme');
    const isDark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    root.classList.toggle('dark', isDark);
    root.style.colorScheme = isDark ? 'dark' : 'light';
  }

  document.addEventListener('astro:page-load', () => {
    // Guard against the ClientRouter resetting <html> state on navigation
    applyStoredTheme();

    const btn = document.getElementById('theme-toggle');
    if (btn && !btn.dataset.themeBound) {
      btn.dataset.themeBound = 'true';
      btn.addEventListener('click', () => {
        const isDark = root.classList.toggle('dark');
        root.style.colorScheme = isDark ? 'dark' : 'light';
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }
  });

  // Follow the OS only while the user hasn't chosen explicitly
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (localStorage.getItem('theme')) return;
    root.classList.toggle('dark', e.matches);
    root.style.colorScheme = e.matches ? 'dark' : 'light';
  });
</script>