---
---

<!-- Hero -->
<section class="grid gap-4 pb-8 pt-16 lg:grid-cols-[15rem_minmax(0,40rem)] lg:gap-20">
	<div class="order-2 font-mono lg:order-none">
		<!-- Terminal command line -->
		<p class="whoami-label tracking-[0.15em] text-md! uppercase text-accent">
			<span>~# <span class="sr-only">whoami</span></span>
			<span class="whoami-text" aria-hidden="true"></span><span class="type-caret" aria-hidden="true"></span>
		</p>

		<!-- Info -->
		<dl class="mt-6 space-y-6 text-xs">
			<div class="hero-fade" style="--d: 600ms">
				<dt class="tracking-[0.12em] text-fg/40">location</dt>
				<dd class="mt-1 text-fg/70">Worcester, MA</dd>
			</div>
			<div class="hero-fade" style="--d: 700ms">
				<dt class="tracking-[0.12em] text-fg/40">focus</dt>
				<dd class="mt-1 text-fg/70">SWE · AppSec · Systems</dd>
			</div>
			<div class="hero-fade" style="--d: 800ms">
				<dt class="tracking-[0.12em] text-fg/40">status</dt>
				<dd class="mt-1 text-accent">Open — Summer 2027</dd>
			</div>
		</dl>
	</div>

	<!-- Main hero -->
	<div class="order-1 lg:order-none">
		<h1 class="hero-name text-6xl leading-[1.05] sm:text-7xl">
			<span class="w"><span class="i">Hayden Schultz</span></span>
			</h1>

			<p class="mt-3 hero-fade font-mono text-accent uppercase" style="--d: 420ms">
			available for summer 2027 internships
			</p>

			<p class="hero-fade mt-3 leading-relaxed text-fg/70" style="--d: 540ms">
			Computer Science and Cybersecurity at Worcester Polytechnic Institute, class of 2028. Looking for a software or security internship for <b>Summer 2027</b>.
			</p>

			<style>
			.hero-name .w {
				display: inline-block;
				padding-bottom: 0.16em;
				margin-bottom: -0.16em;
				clip-path: inset(0 100% 0 0);
			}

			.hero-name .i {
				display: inline-block;
			}

			.hero-fade {
				opacity: 0;
				transform: translateY(0.4rem);
			}

			.whoami-label {
				display: inline-flex;
				align-items: baseline;
			}

			.type-caret {
				display: inline-block;
				width: 0.5em;
				margin-left: 0.05em;
				opacity: 0;
			}

			.type-caret::after {
				content: '_';
			}

			.whoami-label.is-typing .type-caret {
				opacity: 1;
				animation: caret-blink 800ms steps(1) infinite;
			}

			@keyframes caret-blink {
				50% { opacity: 0; }
			}

			:global(.fonts-ready) .hero-name .w {
				animation: wipe 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
			}

			:global(.fonts-ready) .hero-name .i {
				animation: rise 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
			}

			:global(.fonts-ready) .hero-name .w:nth-of-type(2),
			:global(.fonts-ready) .hero-name .w:nth-of-type(2) .i {
				animation-delay: 200ms;
			}

			:global(.fonts-ready) .hero-fade {
				animation: fade 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
				animation-delay: var(--d, 0ms);
			}

			@keyframes wipe {
				from { clip-path: inset(0 100% 0 0); }
				to   { clip-path: inset(0 0 0 0); }
			}

			@keyframes rise {
				from { transform: translateY(0.14em); }
				to   { transform: translateY(0); }
			}

			@keyframes fade {
				from { opacity: 0; transform: translateY(0.4rem); }
				to   { opacity: 1; transform: translateY(0); }
			}

			/* Reduced motion: accessibility */
			@media (prefers-reduced-motion: reduce) {
				.hero-name .w,
				.hero-name .i,
				.hero-fade,
				:global(.fonts-ready) .hero-name .w,
				:global(.fonts-ready) .hero-name .i,
				:global(.fonts-ready) .hero-fade {
				animation: none;
				opacity: 1;
				transform: none;
				clip-path: none;
				}
				.type-caret {
				display: none;
				}
			}
			</style>

			<script>
			document.addEventListener('astro:page-load', () => {
				
				// Listen for the page to load (including client transitions since I use the astro transitions)
				// Small delay, typewriter happens, then the rest comes in 

				const html = document.documentElement;
				html.classList.remove('fonts-ready');

				const label = document.querySelector('.whoami-label');
				const textEl = label?.querySelector('.whoami-text');
				const fullText = ' whoami';
				const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

				document.fonts.ready.then(() => {
					if (!textEl || reduceMotion) {
						if (textEl) textEl.textContent = fullText;
						html.classList.add('fonts-ready');
						return;
					}

					textEl.textContent = '';
					label?.classList.add('is-typing');

					let i = 0;
					const type = () => {
						i++;
						textEl.textContent = fullText.slice(0, i);
						if (i < fullText.length) {
							setTimeout(type, 45);
						} else {
							label?.classList.remove('is-typing');
							setTimeout(() => html.classList.add('fonts-ready'), 200);
						}
					};
					setTimeout(type, 150);
				});
			});
			</script>
	</div>
</section>
