---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import { SOCIALS } from '../consts';
import ThemeToggle from '../components/ThemeToggle.astro';
import { execSync } from 'node:child_process';
import { ClientRouter } from 'astro:transitions';

interface Props {
    title: string;
    description?: string;
}

const { title, description = 'Hayden Schultz — software and security engineering.' } = Astro.props;
const lastCommitDate = execSync('git log -1 --format=%cd --date=short').toString().trim();
const contact = SOCIALS.find(({ name }) => name === 'Contact');
const socials = SOCIALS.filter(({ name }) => name !== 'Contact');
---

<!doctype html>
<html lang="en" class="dark">
<head>
    <ClientRouter />
    <script is:inline>
    const stored = localStorage.getItem('theme');
    const isDark = stored
        ? stored === 'dark'
        : matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.classList.toggle('dark', isDark);
    document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
    <body>
        <header class="sticky top-0 z-10">

            <!-- Gradient and Blur navbar backdrop -->
            <div
                class="py-15 pointer-events-none absolute inset-0 -z-10 backdrop-blur-sm
                    bg-linear-to-b from-bg via-bg/90 to-transparent
                    mask-[linear-gradient(to_bottom,black_55%,transparent)]
                    [-webkit-mask-image:linear-gradient(to_bottom,black_55%,transparent)]"
            ></div>

            <!-- Header/Navbar content -->
            <div class="mx-auto flex max-w-5xl items-center justify-between px-6 pt-10 pb-8">

                <!-- Site logo/home link -->
                <a href="/" class="font-mono text-sm tracking-tight hover:text-accent">
                    haydenschultz<span class="text-accent">.dev</span>
                </a>

                <!-- Socials and light/dark mode toggle -->
                <nav class="flex items-center gap-5">
                    {socials.map(({ name, href, icon }) => (
                    <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={name}
                        class="text-fg/50 transition-colors hover:text-accent"
                    >
                        <Icon name={icon} class="h-4.5 w-4.5" />
                    </a>
                    ))}
                    <span class="hidden h-4 w-px bg-fg/15 lg:block" />
                    {contact && (
                    <a
                        href={contact.href}
                        aria-label={contact.name}
                        class="flex items-center gap-1.5 py-1.5 text-fg/50 hover:text-accent transition-colors"
                    >
                        <Icon name={contact.icon} class="h-4.5 w-4.5" />
                        <span class="hidden font-mono text-xs sm:inline">Contact</span>
                    </a>
                    )}
                    <span class="h-4 w-px bg-fg/15" />
                    <ThemeToggle />
                </nav>
                
            </div>
        </header>

        <slot />

        <!-- Copyright footer -->
        <footer class="mx-auto max-w-5xl px-6 py-10">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <p class="font-mono text-xs text-fg/40">
                © {new Date().getFullYear()} Hayden Schultz
                </p>
                <div class="flex flex-wrap items-center gap-3">
                    <a href={"https://github.com/schultzh06/haydenschultz.dev"} target="_blank" rel="noopener noreferrer"
                    class="font-mono text-xs underline underline-offset-4 text-fg/40 hover:text-accent">
                        <span class="flex flex-row items-center gap-2">
                            <Icon name={"simple-icons:github"} class="h-4.5 w-4.5"/>
                            Website Repo ↗
                        </span>
                    </a>
                    <span class="text-fg/40">·</span>
                    <p class="font-mono text-xs text-fg/40">
                        Last updated {lastCommitDate}
                    </p>
                </div>
            </div>

        </footer>

    </body>
    
</html>