---
import Layout from './Layout.astro';
const { frontmatter, headings = [] } = Astro.props;
const prompts = headings.filter(({ depth, text }) => depth === 2 && text.startsWith('Prompt'));
const permalink = new URL(Astro.url.pathname, Astro.site).href;

// Wrap each "User:" / "Claude:" turn in a styled block at build time so the
// transcript text itself stays verbatim in the Markdown source.
const html = (await Astro.slots.render('default'))
  .replace(
    /<p>User:<\/p>([\s\S]*?)(?=<p>Claude:<\/p>|<h[1-6][\s>]|<p><em>)/g,
    '<div class="turn turn-user"><p class="speaker">User:</p>$1</div>',
  )
  .replace(
    /<p>Claude:<\/p>([\s\S]*?)(?=<h[1-6][\s>])/g,
    '<div class="turn turn-claude"><p class="speaker">Claude:</p>$1</div>',
  );
---
<Layout title={frontmatter.title} description={frontmatter.description}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="mx-auto max-w-5xl px-6 pb-24 pt-8">
    <div class="grid gap-12 lg:grid-cols-[15rem_minmax(0,40rem)] lg:gap-20">

      <!-- Sticky side-bar (left) -->
      <aside class="min-w-0 lg:sticky lg:top-25 lg:h-fit">
        <a href="/" class="font-mono text-sm text-fg/50 transition-colors hover:text-accent">
          &larr; Home
        </a>

        <div class="mt-3 h-px w-full bg-fg/15" />

        <dl class="mt-4 space-y-6 font-mono text-xs">
          {frontmatter.description && (
            <div>
              <dt class="uppercase tracking-[0.15em] text-fg/40">About</dt>
              <dd class="mt-2 leading-relaxed">{frontmatter.description}</dd>
            </div>
          )}
          {frontmatter.recorded && (
            <div>
              <dt class="uppercase tracking-[0.15em] text-fg/40">Recorded</dt>
              <dd class="mt-2">{frontmatter.recorded}</dd>
            </div>
          )}
          <div>
            <dt class="uppercase tracking-[0.15em] text-fg/40">Permalink</dt>
            <dd class="mt-2 break-all">{permalink}</dd>
          </div>
        </dl>

        {prompts.length > 0 && (
          <div class="hidden lg:block">
            <div class="mt-6 h-px w-full bg-fg/15" />
            <p class="mt-4 font-mono text-xs uppercase tracking-[0.15em] text-fg/40">Jump to</p>
            <ol class="mt-2 space-y-2 font-mono text-xs leading-relaxed">
              {prompts.map(({ slug, text }, i) => (
                <li>
                  <a href={`#${slug}`} class="group text-fg/70 transition-colors hover:text-accent">
                    {text}
                    {frontmatter.prompts?.[i] && (
                      <span class="text-fg/40 group-hover:text-accent">&mdash; {frontmatter.prompts[i]}</span>
                    )}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )}
      </aside>

      <article class="transcript min-w-0" set:html={html} />
    </div>
  </div>
</Layout>

<style is:global>
  .transcript {
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .transcript > * + * {
    margin-top: 1.1em;
  }

  .transcript h1 {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .transcript h1:not(:first-child) {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-fg) 20%, transparent);
    font-size: 1.75rem;
  }
  .transcript h1,
  .transcript h2 {
    scroll-margin-top: 6rem;
  }
  .transcript h2 {
    margin-top: 2.75rem;
    font-size: 1.35rem;
    line-height: 1.3;
  }
  .transcript h1 + *,
  .transcript h2 + * {
    margin-top: 0.75rem;
  }

  .transcript a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .transcript strong {
    font-weight: 600;
  }

  .transcript ul,
  .transcript ol {
    padding-left: 1.4em;
  }
  .transcript ul { list-style: disc; }
  .transcript ol { list-style: decimal; }
  .transcript li + li { margin-top: 0.4em; }
  .transcript li::marker { color: var(--color-accent); }

  .transcript table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .transcript thead:not(:has(th:not(:empty))) {
    display: none;
  }
  .transcript td,
  .transcript th {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-fg) 15%, transparent);
    text-align: left;
    vertical-align: top;
  }
  .transcript td:first-child {
    white-space: nowrap;
  }

  .transcript .turn {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
  }
  .transcript .turn > * + * {
    margin-top: 1em;
  }
  .transcript .turn-user {
    background: color-mix(in srgb, var(--color-fg) 7%, transparent);
  }
  .transcript .turn-claude {
    border-left: 3px solid var(--color-accent);
    border-radius: 0;
    padding-block: 0.25rem;
  }
  .transcript .speaker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .transcript .turn-claude .speaker {
    color: var(--color-accent);
    opacity: 1;
  }
</style>
