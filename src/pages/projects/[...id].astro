---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { formatDate, getRecentPosts, postGlyph, projectGlyph } from '../../utils/posts';

export async function getStaticPaths() {
    const projects = await getCollection('projects', ({ data }) => !data.draft);
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { title, hook, summary, role, period, tech, bullets, depth, limitations, links, media, writeups } =
project.data;
const mediaScrollId = `media-scroll-${project.id}`;
const { Content } = await render(project);
const projectPosts = await getRecentPosts({ project: project.id });
const recentPosts = projectPosts.slice(0, 3);
const morePosts = projectPosts.length - recentPosts.length;
---

<Layout title={title + " - Hayden Schultz"} description={summary}>
    <article class="mx-auto max-w-5xl px-6 pb-24 pt-8">
        <!--
            Desktop: sticky sidebar (back, details, posts) beside the article.
            Mobile: the sidebar and article wrappers become display:contents so their blocks can be
            reordered via grid areas: back, title, details, write-up, then recent posts last.
        -->
        <div class="project-grid">

            <!-- Sticky side-bar (left) -->
            <aside class="project-aside min-w-0 lg:sticky lg:top-25 lg:h-fit">

                <!-- Back button -->
                <div class="area-back">
                    <a
                    href="/"
                    class="font-mono text-sm text-fg/50 transition-colors hover:text-accent"
                    >
                        &larr; Back
                    </a>

                    <div class="mt-3 hidden h-px w-full bg-fg/15 lg:block" />
                </div>

                <!-- Role, Stack, Period and links: a compact bordered strip on mobile -->
                <div class="area-meta mt-8 border-y border-fg/15 py-5 lg:mt-0 lg:border-0 lg:py-0">
                <dl class="grid grid-cols-2 gap-x-6 gap-y-4 font-mono text-xs lg:mt-4 lg:block lg:space-y-6">
                    {role && (
                    <div>
                        <dt class="uppercase tracking-[0.15em] text-fg/40">Role</dt>
                        <dd class="mt-2">{role}</dd>
                    </div>
                    )}
                    <div class="col-span-2 lg:col-span-1">
                        <dt class="uppercase tracking-[0.15em] text-fg/40">Stack</dt>
                        <dd class="mt-2 leading-relaxed">{tech.join(' · ')}</dd>
                    </div>
                    <!-- With a role present, Year sits beside it on mobile and Stack gets its own row -->
                    <div class:list={[role && 'row-start-1 col-start-2 lg:row-auto lg:col-auto']}>
                        <dt class="uppercase tracking-[0.15em] text-fg/40">Year</dt>
                        <dd class="mt-2">{period}</dd>
                    </div>
                </dl>
                
                <div class="mt-6 hidden h-px w-full bg-fg/15 lg:block" />

                <!-- Repo and/or Demo Links -->
                {(links.repo || links.demo) && (
                    <div class="mt-5 flex gap-3 lg:mt-6">
                    {links.repo && (
                        <a href={links.repo} target="_blank" rel="noopener noreferrer"
                        class="font-mono text-xs underline underline-offset-4 hover:text-accent">
                            <span class="flex flex-row items-center gap-2">
                                <Icon name={"simple-icons:github"} class="h-4.5 w-4.5"/> 
                                Repo ↗
                            </span>
                        </a>
                    )}
                    {links.demo && (
                        <a
                        href={links.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="rounded-full bg-accent px-4 py-1.5 text-sm text-bg transition-opacity hover:opacity-90"
                        >
                        Demo &nearr;
                        </a>
                    )}
                    </div>
                )}
                </div>

                <!-- Recent posts about this project (moves below the write-up on mobile) -->
                {recentPosts.length > 0 && (
                    <div class="area-posts mt-12 font-mono text-xs lg:mt-6">
                        <div class="mb-6 h-px w-full bg-fg/15" />
                        <p class="uppercase tracking-[0.15em] text-fg/40">Recent posts</p>
                        <ul class="mt-3 space-y-2">
                            {recentPosts.map((post) => (
                                <li>
                                    <a
                                    href={`/posts/${post.id}`}
                                    class="group flex flex-col rounded-sm border border-fg/10 p-3 transition-colors hover:border-accent/60"
                                    >
                                        <span class="flex items-center justify-between gap-2 text-fg/50">
                                            {formatDate(post.data.published)}
                                            <Icon name={postGlyph(post)} transition:name={`post-glyph-${post.id}`} class="h-3.5 w-3.5 shrink-0 transition-colors group-hover:text-accent" />
                                        </span>
                                        <span transition:name={`post-title-${post.id}`} class="mt-1.5 line-clamp-2 font-display text-base leading-snug text-fg transition-colors group-hover:text-accent">{post.data.title}</span>
                                        <span transition:name={`post-desc-${post.id}`} class="mt-1 line-clamp-2 font-body text-xs leading-relaxed text-fg/60">{post.data.description}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                        <a href={`/posts?project=${project.id}`} class="mt-4 inline-block underline underline-offset-4 hover:text-accent">
                            {morePosts > 0 ? `+${morePosts} more · ` : ''}All posts &rarr;
                        </a>
                    </div>
                )}
            </aside>

            <!-- Article bulk -->
            <div class="project-main min-w-0">

                <!-- Title and Hook (header) -->
                <header class="area-header mt-4 lg:mt-8">
                    <h1 transition:name={`title-${project.id}`} class="mt-2 text-4xl sm:text-5xl">
                        <!-- Inline glyph sized in em so it scales with the title; wrapped lines start at the icon's margin -->
                        <Icon name={projectGlyph(project.id)} transition:name={`glyph-${project.id}`} class="mr-[0.2em] inline-block h-[0.8em] w-[0.8em] align-[-0.06em] text-accent" />{title}
                    </h1>
                    <p transition:name={`hook-${project.id}`} class="mt-4 text-lg leading-relaxed text-fg/70">{hook}</p>
                </header>

                <div class="area-body min-w-0">
                <!-- Brief -->
                <p class="mt-10 font-display text-xl leading-snug text-fg sm:text-2xl">
                    {bullets.join(' ')}
                </p>

                <!-- Media -->
                {media && media.length > 0 && (
                <section class="mt-12">
                    <div>
                        <div
                            id={mediaScrollId}
                            class="media-scroll flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2"
                        >
                        {media.map((item, i) => (
                            <figure class="w-full shrink-0 snap-center" data-index={i}>
                                <p class="text-md mb-1 font-mono uppercase text-accent">> {item.alt}</p>
                                <button
                                    type="button"
                                    class="media-open group block w-full cursor-zoom-in"
                                    aria-label={`View ${item.alt} full size`}
                                    data-caption={item.caption}
                                >
                                    <Image
                                        src={item.src}
                                        alt={item.alt}
                                        widths={[400, 800, 1200]}
                                        sizes="(min-width: 1024px) 40rem, 100vw"
                                        class="w-full border-2 border-fg/15 rounded-sm transition-opacity group-hover:opacity-90"
                                    />
                                </button>
                                <figcaption class="mt-2 min-h-8 font-mono text-xs text-fg/50">{item.caption}</figcaption>
                            </figure>
                        ))}
                        </div>
                        {media.length > 1 && (
                        <>
                            
                            
                        </>
                        )}
                    </div>
                    {/* Progress dots and directional media arrows */}
                    {media.length > 1 && (
                        <div class="flex flex-row justify-between">
                            <button
                                type="button"
                                class="media-prev rounded-sm border border-fg/15 bg-bg/80 p-2 text-fg/60 backdrop-blur transition-colors hover:text-accent"
                                aria-label="Previous media"
                                data-target={mediaScrollId}
                            >
                                <Icon name="lucide:chevron-left" class="h-4 w-4" />
                            </button>
                            <div class="mt-3 flex justify-center gap-2">
                                {media.map((_, i) => (
                                    <button
                                        type="button"
                                        class="media-dot h-1.5 w-1.5 bg-fg/25 transition-colors"
                                        aria-label={`Go to media ${i + 1}`}
                                        data-target={mediaScrollId}
                                        data-index={i}
                                    />
                                ))}
                            </div>
                            <button
                                type="button"
                                class="media-next rounded-sm border border-fg/15 bg-bg/80 p-2 text-fg/60 backdrop-blur transition-colors hover:text-accent"
                                aria-label="Next media"
                                data-target={mediaScrollId}
                            >
                                <Icon name="lucide:chevron-right" class="h-4 w-4" />
                            </button>
                        </div>
                    
                    )}

                    {/* Lightbox */}
                    <dialog id={`media-lightbox-${project.id}`} class="media-lightbox">
                        <button type="button" class="lightbox-close" aria-label="Close">
                            <Icon name="lucide:x" class="h-5 w-5" />
                        </button>
                        <img class="lightbox-img" alt="" />
                        <p class="lightbox-caption"></p>
                    </dialog>
                </section>
                )}

                <div class="mt-12 h-px w-full bg-fg/15" />

                <!-- Depth bullets -->
                {depth && (
                <section class="mt-12">
                    <h2 class="font-mono text-xs uppercase tracking-[0.15em] text-accent">Under the hood</h2>
                    <ul class="mt-4 space-y-3">
                    {depth.map((point) => (
                        <li class="flex gap-3 text-sm leading-relaxed text-fg/80">
                        <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent"></span>
                        <span>{point}</span>
                        </li>
                    ))}
                    </ul>
                </section>
                )}

                <!-- Limitations -->
                {limitations && (
                <section class="mt-12">
                    <h2 class="font-mono text-xs uppercase tracking-[0.15em] text-accent">Limitations</h2>
                    <ul class="mt-4 space-y-3">
                    {limitations.map((point) => (
                        <li class="flex gap-3 text-sm leading-relaxed text-fg/60">
                        <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-fg/30"></span>
                        <span>{point}</span>
                        </li>
                    ))}
                    </ul>
                </section>
                )}

                <!-- Writeups -->
                {writeups && (
                <section class="mt-12 space-y-8">
                    {writeups.map((writeup) => (
                    <div>
                        <h2 class="text-xl">{writeup.title}</h2>
                        <p class="mt-3 text-sm leading-relaxed text-fg/80">{writeup.entry}</p>
                    </div>
                    ))}
                </section>
                )}

                <div class="mt-12 h-px w-full bg-fg/15" />

                <!-- Content -->
                <div class="content mt-12">
                    <Content />
                </div>
                </div>
                
            </div>
        </div>
    </article>
</Layout>

<script>
    function bindMediaGalleries() {
        document.querySelectorAll<HTMLElement>('.media-scroll').forEach((scroller) => {
            if (scroller.dataset.mediaBound) return;
            scroller.dataset.mediaBound = 'true';

            const id = scroller.id;
            const figures = Array.from(scroller.querySelectorAll<HTMLElement>('[data-index]'));
            const dots = document.querySelectorAll<HTMLElement>(`.media-dot[data-target="${id}"]`);

            let currentIndex = 0;

            const goToIndex = (index: number) => {
                const clamped = Math.max(0, Math.min(figures.length - 1, index));
                figures[clamped]?.scrollIntoView({
                    behavior: 'smooth',
                    inline: 'center',
                    block: 'nearest',
                });
            };

            document.querySelectorAll<HTMLElement>(`.media-prev[data-target="${id}"], .media-next[data-target="${id}"]`)
                .forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const direction = btn.classList.contains('media-prev') ? -1 : 1;
                        goToIndex(currentIndex + direction);
                    });
                });

            dots.forEach((dot) => {
                dot.addEventListener('click', () => goToIndex(Number(dot.dataset.index)));
            });

            if (dots.length === 0) return;

            // Highlight whichever slide is currently centered in the scroller as the user scrolls or uses the arrows
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        const index = Number((entry.target as HTMLElement).dataset.index);
                        currentIndex = index;
                        dots.forEach((dot) => dot.classList.toggle('is-active', Number(dot.dataset.index) === index));
                    });
                },
                { root: scroller, threshold: 0.6 }
            );

            figures.forEach((figure) => observer.observe(figure));
        });
    }

    function bindMediaLightbox() {
        document.querySelectorAll<HTMLDialogElement>('.media-lightbox').forEach((dialog) => {
            if (dialog.dataset.lightboxBound) return;
            dialog.dataset.lightboxBound = 'true';

            const img = dialog.querySelector<HTMLImageElement>('.lightbox-img');
            const caption = dialog.querySelector<HTMLElement>('.lightbox-caption');
            const closeBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-close');
            const section = dialog.closest('section');

            section?.querySelectorAll<HTMLButtonElement>('.media-open').forEach((btn) => {
                btn.addEventListener('click', () => {
                    const sourceImg = btn.querySelector('img');
                    if (!sourceImg || !img) return;
                    img.src = sourceImg.currentSrc || sourceImg.src;
                    img.alt = sourceImg.alt;
                    if (caption) caption.textContent = btn.dataset.caption ?? '';
                    document.documentElement.classList.add('lightbox-open');
                    dialog.showModal();
                });
            });

            closeBtn?.addEventListener('click', () => dialog.close());
            dialog.addEventListener('click', (event) => {
                if (event.target === dialog) dialog.close();
            });
            
            dialog.addEventListener('close', () => {
                document.documentElement.classList.remove('lightbox-open');
            });
        });
    }

    document.addEventListener('astro:page-load', bindMediaGalleries);
    document.addEventListener('astro:page-load', bindMediaLightbox);
</script>

<style>
.project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
        "back"
        "header"
        "meta"
        "body"
        "posts";
}

.project-aside,
.project-main {
    display: contents;
}

.area-back { grid-area: back; }
.area-header { grid-area: header; }
.area-meta { grid-area: meta; }
.area-body { grid-area: body; }
.area-posts { grid-area: posts; }

@media (min-width: 64rem) {
    .project-grid {
        grid-template-columns: 15rem minmax(0, 40rem);
        grid-template-areas: none;
        column-gap: 5rem;
        align-items: start;
    }

    .project-aside,
    .project-main {
        display: block;
    }

    .area-back,
    .area-header,
    .area-meta,
    .area-body,
    .area-posts {
        grid-area: auto;
    }
}

.media-scroll {
    scrollbar-width: none;
}

.media-scroll::-webkit-scrollbar {
    display: none;
}

.media-dot.is-active {
    background: var(--color-accent);
    width: 1.25rem;
}

:global(html.lightbox-open) {
    overflow: hidden;
}

.media-lightbox {
    position: fixed;
    inset: 0;
    display: none;
    width: 100dvw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: none;
    background: transparent;
    padding: 2rem;
}

.media-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
}

.media-lightbox::backdrop {
    background: color-mix(in oklab, var(--color-bg) 80%, transparent);
}

.lightbox-img {
    max-width: 100%;
    max-height: calc(100dvh - 6rem);
    border-radius: 0.5rem;
    object-fit: contain;
}

.lightbox-caption {
    position: absolute;
    right: 0;
    bottom: 1.5rem;
    left: 0;
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: 2rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0rem;
    color: color-mix(in oklab, white 70%, transparent);
}

.lightbox-close {
    position: absolute;
    top: 1rem;
    right: 2rem;
    border-radius: 2px;
    background: color-mix(in oklab, black 40%, transparent);
    padding: 0.5rem;
    color: white;
    transition: background-color 0.15s;
}

.lightbox-close:hover {
    background: color-mix(in oklab, black 60%, transparent);
}
</style>
